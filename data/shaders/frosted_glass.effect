// ============================================================================
// frosted_glass.effect — Efeito Glassmorphism para Broadcast Overlay
//
// Cria um visual de vidro fosco (frosted glass) moderno com:
//   - Cor de base configurável
//   - Highlight/reflexo animado
//   - Gradiente suave de topo para base
//   - Ruído sutil (procedural) para textura de vidro
//   - Tint/tonalidade de vidro
//
// Técnicas:
//   VerticalGlass   — reflexo vertical (barras laterais, painéis altos)
//   HorizontalGlass — reflexo horizontal (barras full-width, rodapés)
//
// Parâmetros usados por draw_rect_glass() em graphics-render.cpp:
//   color           — cor ARGB base do fundo
//   highlight_color — cor do reflexo (branco semi-transparente)
//   gradient_top    — posição do topo do gradiente (0-1)
//   gradient_bot    — posição da base do gradiente (0-1)
//   noise_strength  — intensidade do ruído procedural (0-1)
//   glass_tint      — tonalidade do vidro (0-1)
//   highlight_width — largura da faixa de reflexo (0-1)
// ============================================================================

uniform float4 color;
uniform float4 highlight_color;
uniform float  gradient_top;
uniform float  gradient_bot;
uniform float  noise_strength;
uniform float  glass_tint;
uniform float  highlight_width;

// ============================================================================
// Vertex Shader
// ============================================================================
struct vert_data {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

vert_data vertex_shader(float4 pos : POSITION, float2 uv : TEXCOORD0)
{
    vert_data v;
    v.pos = pos;
    v.uv  = uv;
    return v;
}

// ============================================================================
// Pixel Shader — Frotaed Glass
// ============================================================================

// Ruído procedural simples (hash function)
float hash(float2 p)
{
    float3 p3 = frac(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float noise(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);

    float a = hash(i);
    float b = hash(i + float2(1.0, 0.0));
    float c = hash(i + float2(0.0, 1.0));
    float d = hash(i + float2(1.0, 1.0));

    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float4 pixel_shader_glass(float4 pos : POSITION, float2 uv : TEXCOORD0) : COLOR
{
    float4 base_color = color;

    // ── Gradient vertical (top → bottom) ──────────────────────────────
    float gradient_pos = 1.0 - uv.y;  // 0 = top, 1 = bottom
    float gradient_mask = smoothstep(gradient_top, gradient_bot, gradient_pos);
    float4 gradient_color = lerp(base_color, base_color * 1.15, gradient_mask);

    // ── Highlight reflection ─────────────────────────────────────────
    // Faixa com movimento suave que percorre a superficie (sweep diagonal)
    float hl_center = 0.3 + 0.15 * sin(uv.x * 6.28 + uv.y * 3.14);
    float hl_mask = exp(-pow((1.0 - uv.y) - hl_center, 2.0) / (highlight_width * 0.5));
    float4 hl = highlight_color * hl_mask * 0.6;

    // ── Ruído procedural (textura de vidro) ──────────────────────────
    float n = noise(uv * 800.0 + 1.0);
    float noise_amount = noise_strength * 0.06;
    float4 noise_color = float4(n * noise_amount, n * noise_amount, n * noise_amount, 0.0);

    // ── Glass tint (ligeira desaturação + azulamento) ────────────────
    float gray = dot(gradient_color.rgb, float3(0.299, 0.587, 0.114));
    float4 tinted = lerp(float4(gray, gray, gray, gradient_color.a),
                         gradient_color, 1.0 - glass_tint * 0.4);
    tinted = lerp(tinted, float4(0.85, 0.9, 1.0, tinted.a), glass_tint * 0.15);

    // ── Composição final ─────────────────────────────────────────────
    float4 result = tinted + hl + noise_color;
    result.a = gradient_color.a;
    return saturate(result);
}

// ============================================================================
// Técnica: VerticalGlass — reflexo vertical (para painéis laterais)
// ============================================================================
technique VerticalGlass
{
    pass
    {
        vertex_shader   = vertex_shader();
        pixel_shader    = pixel_shader_glass();
    }
}

// ============================================================================
// Técnica: HorizontalGlass — reflexo horizontal (para barras full-width)
// ============================================================================
technique HorizontalGlass
{
    pass
    {
        vertex_shader   = vertex_shader();
        pixel_shader    = pixel_shader_glass();
    }
}
